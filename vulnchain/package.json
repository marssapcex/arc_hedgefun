{
  "name": "vulnchain",
  "version": "1.0.0",
  "private": true,
  "description": "Merged BugChainIndexer + DeFi-Security-Incident (821 reports) into one deployable codebase: single-EVM-chain similarity scanner",
  "main": "src/cli.js",
  "scripts": {
    "build-corpus": "node src/cli.js build-corpus",
    "make-fixture": "node src/cli.js make-fixture",
    "selftest": "node src/cli.js selftest",
    "demo": "node src/cli.js scan --fixture",
    "scan": "node src/cli.js scan",
    "scan:live": "node src/cli.js scan --network ethereum --blocks 40 --mode hybrid --max-contracts 60 --sourcify",
    "test": "node --test test/*.test.js",
    "server": "node server/backend/index.js",
    "full": "node src/cli.js full-scan --full --resume",
    "full:smoke": "node src/cli.js full-scan --from-block 0 --to-block 400 --chunk 100 --max-chunks 4 --resume",
    "chains": "node src/cli.js chains"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "axios": "^1.10.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "ethers": "^6.15.0",
    "express": "^5.1.0",
    "pg": "^8.16.3"
  },
  "license": "MIT"
}
